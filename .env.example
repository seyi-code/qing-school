# Copy to .env locally. On Vercel: Project → Settings → Environment Variables.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
SETUP_SECRET="one-time-seed-secret-for-phone-setup"

# Production bootstrap only — set true briefly, then REMOVE
# ALLOW_PRODUCTION_SETUP="true"
# ALLOW_SETUP_SEED="false"

# Public site URL (Paystack / Flutterwave callbacks)
NEXT_PUBLIC_APP_URL="https://qing-school.vercel.app"

# Payments — mock until keys are ready
PAYMENTS_MODE="mock"
# PAYMENTS_MODE=live

# Paystack SaaS subscriptions
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
PAYSTACK_PLAN_STARTER=""
PAYSTACK_PLAN_PRO=""
PAYSTACK_PLAN_ENTERPRISE=""

# Flutterwave SaaS checkout
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""
FLUTTERWAVE_PLAN_STARTER=""
FLUTTERWAVE_PLAN_PRO=""
FLUTTERWAVE_PLAN_ENTERPRISE=""

# Optional: suspend school when subscription past_due
# SUSPEND_ON_PAST_DUE="true"

# Vercel Blob (logo / CMS uploads)
BLOB_READ_WRITE_TOKEN=""

# SMS — leave empty for mock (logs to MessageLog)
TERMII_API_KEY=""
TERMII_SENDER_ID="KMS"

# Email (optional)
# RESEND_API_KEY=""
# SMTP_HOST=""
