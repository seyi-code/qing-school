// Qing School ERP — multi-tenant school management SaaS
// Money fields: Decimal(12,2) on staging — always toMoney() in TS
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  ADMIN
  IT
  SECRETARY
  PRINCIPAL
  ACCOUNTANT
  TEACHER
  STUDENT
  PARENT
}

model School {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  shortName       String
  motto           String?
  tagline         String?
  logoUrl         String?
  primaryColor    String   @default("#1a3a6e")
  accentColor     String   @default("#c9a227")
  phone           String?
  phoneAlt        String?
  email           String?
  address         String?
  location        String?
  plan            String   @default("STARTER")
  isActive        Boolean  @default(true)
  isDemo          Boolean  @default(false)
  maxStudents     Int      @default(500)
  billingEmail              String?
  paystackCustomerCode      String?
  paystackSubscriptionCode  String?
  subscriptionStatus        String   @default("NONE")
  planRenewsAt              DateTime?
  // Phase 4: verified custom domain for school public site (host match)
  customDomain      String?
  domainVerifiedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]
  students        Student[]
  staff           Staff[]
  classes         SchoolClass[]
  notices         Notice[]
  cmsPages        CmsPage[]
  academicYears   Session[]
  auditLogs       AuditLog[]
  libraryBooks    LibraryBook[]
  hostelRooms     HostelRoom[]
  transportRoutes TransportRoute[]
  cbtExams        CbtExam[]
  expenses        ExpenseRecord[]
  branches        Branch[]

  @@unique([customDomain])
  @@index([isActive])
  @@index([customDomain])
}

model Branch {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code      String
  name      String
  isDefault Boolean   @default(false)
  students  Student[]
  createdAt DateTime  @default(now())

  @@unique([schoolId, code])
  @@index([schoolId])
}
